; Line-locked oversampling of the P2000M's conditioned monochrome VIDEO.
;
; IN base points at VIDEO_IN. HSYNC_IN and VSYNC_IN are the following two pins.
; The state machine runs at a uniform 63 MHz (126 MHz system clock / 2).
; Each visible scanline starts from its own HSYNC edge. A block contains two
; groups of fourteen consecutive VIDEO samples; the loop branch leaves one
; unsampled PIO cycle after each group. Autopush therefore emits 28 useful bits
; in every word, with bits 31:28 unused. 228 groups produce 114 words spanning
; 54.286 us, including timing margin on both sides of the 640-dot active area.

.program p2000m_capture

.wrap_target
    wait 1 pin 2                   ; VSYNC idle
    wait 0 pin 2                   ; VSYNC asserted: frame line 0
    pull block
    mov y, osr                     ; 287: capture 288 visible lines

    set x, 23                      ; Skip row 25 and row 0: 24 scanlines
skip_blank_lines:
    wait 1 pin 1                   ; HSYNC idle
    wait 0 pin 1                   ; HSYNC asserted / next line edge
    jmp x-- skip_blank_lines

line_start:
    set x, 31
raw_start_delay:
    jmp x-- raw_start_delay [11]   ; 384 PIO cycles
    nop [20]                       ; Start roughly two dots before active VIDEO

    pull block
    mov x, osr                     ; 227: capture 228 fourteen-sample groups
sample_group:
    in pins, 1
    in pins, 1
    in pins, 1
    in pins, 1
    in pins, 1
    in pins, 1
    in pins, 1
    in pins, 1
    in pins, 1
    in pins, 1
    in pins, 1
    in pins, 1
    in pins, 1
    in pins, 1
    jmp x-- sample_group           ; One unsampled cycle per fourteen samples

    jmp y-- next_line
.wrap

next_line:
    wait 1 pin 1
    wait 0 pin 1
    jmp line_start
