/**
 * @file version.rc.in
 * @brief Windows version metadata generated from the CMake project version.
 */

#include <windows.h>

#define IDI_APP_ICON 101
IDI_APP_ICON ICON DISCARDABLE "@CMAKE_CURRENT_SOURCE_DIR@/assets/p2000m-vid2vga-viewer.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ivo Filot\0"
            VALUE "FileDescription", "P2000M VID2VGA Viewer\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "p2000m-vid2vga-viewer\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Ivo Filot\0"
            VALUE "OriginalFilename", "p2000m-vid2vga-viewer.exe\0"
            VALUE "ProductName", "P2000M VID2VGA Viewer\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
